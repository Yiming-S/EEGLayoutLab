# Keep repository-root additions limited to EEGLayoutLab's source and docs.
/*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/pyproject.toml
!/configs/
!/data/
!/desktop/
!/docs/
!/scripts/
!/src/
!/tests/
!/webapp/

# Rebuilt dependency environments and outputs
.runtime/
.venv/
node_modules/
dist/
.next/
.vinext/
.wrangler/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage*
coverage/
*.tsbuildinfo

# Scientific payloads are supplied as a separately verified data bundle.
data/*
!data/README.md
!data/manifest.json
!data/SOURCES.md
/results/
/releases/
.data-install-*/
.data-export-*

# Per-user computed jobs, browser captures and temporary output
/artifacts/
outputs/
work/
tmp/
*.log
.DS_Store

# Desktop installers and release archives are distributed separately from Git.
*.app/
*.dmg
*.zip
*.tar.gz

# Credentials, personal machine configuration and old development context
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx
.openai/
.codex/
.claude/
.agents/
OLD/
