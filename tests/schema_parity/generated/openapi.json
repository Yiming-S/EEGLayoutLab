{
  "openapi": "3.1.0",
  "info": {
    "title": "EEGLayoutLab schema spike",
    "version": "0.0.0"
  },
  "paths": {
    "/api/spike/design-evaluation/normalize": {
      "post": {
        "summary": "Normalize Design Evaluation",
        "operationId": "normalize_design_evaluation_api_spike_design_evaluation_normalize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/DesignEvaluationRequest"
                  },
                  {
                    "$ref": "#/components/schemas/DesignSubmission"
                  }
                ],
                "title": "Body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NormalizedDesignRequest"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BrainBackgroundNoise": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "brain_background",
            "title": "Kind"
          },
          "fraction": {
            "type": "number",
            "const": 0.5,
            "title": "Fraction"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "fraction"
        ],
        "title": "BrainBackgroundNoise",
        "description": "Design evaluation only; the radius search rejects it."
      },
      "DataPrior": {
        "properties": {
          "region_gain": {
            "items": {
              "type": "number",
              "maximum": 1000.0,
              "minimum": 0.001
            },
            "type": "array",
            "maxItems": 7,
            "minItems": 7,
            "title": "Region Gain"
          },
          "rho": {
            "type": "number",
            "maximum": 0.95,
            "minimum": 0.0,
            "title": "Rho"
          },
          "length_mm": {
            "anyOf": [
              {
                "type": "integer",
                "enum": [
                  5,
                  10,
                  15,
                  20,
                  30,
                  40
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Length Mm"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "region_gain",
          "rho",
          "length_mm"
        ],
        "title": "DataPrior",
        "description": "The ``request`` value of an ``eeg-data-prior/1`` file; rejected, never rounded."
      },
      "DesignEvaluationRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "evaluate",
              "perturb"
            ],
            "title": "Action"
          },
          "design": {
            "$ref": "#/components/schemas/ElectrodeDesign"
          },
          "radius_mm": {
            "type": "integer",
            "enum": [
              3,
              6,
              10
            ],
            "title": "Radius Mm"
          },
          "seed": {
            "type": "integer",
            "maximum": 9999.0,
            "minimum": 0.0,
            "title": "Seed"
          },
          "noise_model": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/IidNoise"
                  },
                  {
                    "$ref": "#/components/schemas/SpatialNoise"
                  },
                  {
                    "$ref": "#/components/schemas/BrainBackgroundNoise"
                  }
                ],
                "discriminator": {
                  "propertyName": "kind",
                  "mapping": {
                    "brain_background": "#/components/schemas/BrainBackgroundNoise",
                    "iid": "#/components/schemas/IidNoise",
                    "spatial": "#/components/schemas/SpatialNoise"
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "title": "Noise Model"
          },
          "conductivity_scenario": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "skull_x0.5",
                  "skull_x2"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Conductivity Scenario"
          },
          "head_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Head Id"
          },
          "robustness": {
            "anyOf": [
              {
                "type": "string",
                "const": "standard/1"
              },
              {
                "type": "null"
              }
            ],
            "title": "Robustness"
          },
          "data_prior": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DataPrior"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "design",
          "radius_mm",
          "seed"
        ],
        "title": "DesignEvaluationRequest",
        "description": "Body of ``POST /api/design-evaluation/jobs``. Unknown top-level fields are rejected."
      },
      "DesignSubmission": {
        "properties": {
          "schema": {
            "type": "string",
            "const": "design-submission/1",
            "title": "Schema"
          },
          "request": {
            "$ref": "#/components/schemas/DesignEvaluationRequest"
          },
          "electrode_names": {
            "items": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 64,
            "minItems": 64,
            "uniqueItems": true,
            "title": "Electrode Names"
          },
          "source_metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema",
          "request",
          "electrode_names"
        ],
        "title": "DesignSubmission"
      },
      "ElectrodeDesign": {
        "properties": {
          "schema": {
            "type": "string",
            "const": "eeg-electrode-design/1",
            "title": "Schema"
          },
          "coordinate_system": {
            "type": "string",
            "const": "ernie_native_mm",
            "title": "Coordinate System"
          },
          "unit": {
            "type": "string",
            "const": "mm",
            "title": "Unit"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "default": "导入布局"
          },
          "xyz_mm": {
            "items": {
              "prefixItems": [
                {
                  "type": "number",
                  "maximum": 500.0,
                  "minimum": -500.0
                },
                {
                  "type": "number",
                  "maximum": 500.0,
                  "minimum": -500.0
                },
                {
                  "type": "number",
                  "maximum": 500.0,
                  "minimum": -500.0
                }
              ],
              "type": "array",
              "maxItems": 3,
              "minItems": 3
            },
            "type": "array",
            "maxItems": 64,
            "minItems": 64,
            "title": "Xyz Mm"
          },
          "region_indices": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 64,
            "minItems": 64,
            "title": "Region Indices"
          }
        },
        "type": "object",
        "required": [
          "schema",
          "coordinate_system",
          "unit",
          "xyz_mm",
          "region_indices"
        ],
        "title": "ElectrodeDesign",
        "description": "``eeg-electrode-design/1`` in Ernie native millimetres. Other design fields are dropped."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IidNoise": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "iid",
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "IidNoise",
        "description": "Accepted for the production model and dropped from canonical output."
      },
      "NormalizedDesignRequest": {
        "properties": {
          "request": {
            "$ref": "#/components/schemas/DesignEvaluationRequest"
          },
          "request_sha256": {
            "type": "string",
            "title": "Request Sha256"
          },
          "electrode_names": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "maxLength": 128,
                  "minLength": 1
                },
                "type": "array",
                "maxItems": 64,
                "minItems": 64,
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Electrode Names"
          }
        },
        "type": "object",
        "required": [
          "request",
          "request_sha256"
        ],
        "title": "NormalizedDesignRequest",
        "description": "Documentation of the response; the body itself is written with JSON.stringify semantics."
      },
      "SpatialNoise": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "spatial",
            "title": "Kind"
          },
          "rho": {
            "type": "number",
            "const": 0.5,
            "title": "Rho"
          },
          "length_mm": {
            "type": "integer",
            "enum": [
              10,
              20,
              40
            ],
            "title": "Length Mm"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "rho",
          "length_mm"
        ],
        "title": "SpatialNoise"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
