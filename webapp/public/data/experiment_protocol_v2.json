{
  "protocol_version": "2.0.0-draft.2",
  "status": "design_only_no_results",
  "date": "2026-09-06",
  "objective": "With exactly 64 measurement electrodes, optimize a small number of compact anatomical surface regions, their sizes, and all within-region electrode coordinates so that reference-independent BioSemi64 scalp-field reconstruction, whole-cortical-surface normal-source sensitivity, and single-source localization retain as much performance as possible relative to a standard full-head BioSemi64 reference.",
  "scientific_scope": {
    "primary_source_domain": "whole_cortical_surface_normal_dipoles",
    "whole_brain_volume_claim_allowed": false,
    "deep_or_volume_sources": "secondary_sensitivity_analysis_only_after_a_volume_source_protocol_is_frozen",
    "task_accuracy_claim_allowed": false
  },
  "claims": {
    "v2_results_available": false,
    "task_accuracy_claims_allowed": false,
    "human_equivalence_claims_allowed": false,
    "current_outputs_are_protocol_design_only": true
  },
