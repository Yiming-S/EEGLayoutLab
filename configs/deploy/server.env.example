# Start with: node --env-file=/absolute/path/server.env webapp/server/start.mjs
# The service always binds to loopback. Use an HTTPS reverse proxy for hosting.
PORT=3000
EEG_MAINTENANCE=1

# Optional absolute path to scientific source, model data, records and runtime.
# Default: the repository containing webapp/.
# EEG_REPOSITORY_ROOT=/srv/eeg/science
# EEG_QUEUE_DIRECTORY=/srv/eeg/queue
# EEG_COMPUTE_PYTHON=/srv/eeg/science/.runtime/simnibs-4.6.0/bin/python

# Set both only after configuring the proxy. Without these, access is local only.
# No subdirectory, query, credentials, or fragment is accepted in the origin.
# EEG_PUBLIC_ORIGIN=https://eeg.example.org
# EEG_TRUSTED_PROXIES=127.0.0.1

# Admission checks for new uncached calculations and project writes.
# Values are MiB. Reads, cache replay and cancellation remain available.
# Disk checks cover both scientific and queue filesystems; 0 disables the floor.
EEG_MIN_FREE_DISK_MB=512
# Current Node host RSS only. 0 disables this soft admission threshold.
# This does not limit Python/native worker memory or enforce an OS memory cap.
EEG_MAX_HOST_RSS_MB=0
# Private request log: 1-10 MiB/day, seven UTC days, bounded pending queue.
EEG_OPERATIONS_LOG_MB=5

# Result library visibility. Default `shared`: every visitor's records, including the
# names given to coordinate files, are listed to everyone. `owner` lists a record only
# to its owners until one publishes it; with review on (the default in that mode, 0
# turns it off) a publication is listed after `npm run library:moderate -- ... approve <id>`.
# EEG_LIBRARY_SCOPE=shared
# EEG_LIBRARY_REVIEW=1
